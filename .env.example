# Used only by scripts/check-streams.ts (locally or in the GitHub Action). The web app has no server and no secrets.
IPTV_PLAYLIST_URL="https://iptv-org.github.io/iptv/index.m3u"
# Origin the app is served from — used to verify CORS. GitHub Pages: https://<user>.github.io
APP_ORIGIN="https://maikrogerio.github.io"
STREAM_CHECK_TIMEOUT_MS=8000
STREAM_CHECK_CONCURRENCY=24
STREAM_CHECK_DEEP=true
REQUIRE_HTTPS=true
REQUIRE_CORS=true
